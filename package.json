{
  "name": "mcp-jira-updates",
  "version": "1.0.0",
  "description": "Connects GitHub commit history to Jira to automatically update changelogs and versioning on merge or on demand.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "jira-changelog": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts sync",
    "sync": "tsx src/cli.ts sync",
    "cli": "tsx src/cli.ts",
    "dry-run": "tsx src/cli.ts sync --dry-run"
  },
  "keywords": [
    "github",
    "jira",
    "changelog",
    "versioning",
    "git",
    "mcp",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^20.1.0",
    "axios": "^1.7.9",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
