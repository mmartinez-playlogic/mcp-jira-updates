# GitHub Credentials & Settings
# GitHub Personal Access Token or automatically provided GITHUB_TOKEN in GitHub Actions
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-repository-name
GITHUB_BRANCH=main

# Jira / Confluence Credentials & Settings
JIRA_HOST=https://playlogiq.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_atlassian_api_token

# Target Confluence Page URL or Page ID (e.g. 888995841)
CONFLUENCE_PAGE_URL=https://playlogiq.atlassian.net/wiki/spaces/SD/pages/888995841/Changelogs
CONFLUENCE_PAGE_ID=888995841

# Mode options: "confluence_page", "issue_comment", "issue_description", "jira_version"
JIRA_UPDATE_MODE=confluence_page

# Versioning Options
# Version prefix (e.g. v1.0.0 or v)
VERSION_PREFIX=v1.0.0
# Include short commit hash in version string (true/false)
INCLUDE_COMMIT_HASH=true

# Notification Settings
# Optional Webhook URL (e.g. Slack / Discord / Teams / Custom webhook)
NOTIFICATION_WEBHOOK_URL=
