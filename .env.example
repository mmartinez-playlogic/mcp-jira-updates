# GitHub Credentials & Settings
# GitHub Personal Access Token or automatically provided GITHUB_TOKEN in GitHub Actions
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-repository-name
GITHUB_BRANCH=main

# Jira Credentials & Settings
# Your Jira Cloud base URL (e.g., https://your-domain.atlassian.net)
JIRA_HOST=https://your-domain.atlassian.net
# Your Atlassian account email
JIRA_EMAIL=user@example.com
# API Token generated at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token
# Target Jira Project Key (e.g., PROJ)
JIRA_PROJECT_KEY=PROJ
# Target Jira Issue Key (e.g., PROJ-123) to post comments/changelog updates to
JIRA_ISSUE_KEY=PROJ-1
# Mode: "issue_comment", "issue_description", or "jira_version"
JIRA_UPDATE_MODE=issue_comment

# Versioning Options
# Version prefix (e.g. v1.0.0 or v)
VERSION_PREFIX=v1.0.0
# Include short commit hash in version string (true/false)
INCLUDE_COMMIT_HASH=true

# Notification Settings
# Optional Webhook URL (e.g. Slack / Discord / Teams / Custom webhook)
NOTIFICATION_WEBHOOK_URL=
